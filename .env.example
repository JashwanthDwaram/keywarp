# Google Gemini API Key for KeyWarp AI Typing Coach (server-side only!)
# Get your free key at: https://aistudio.google.com/
# Configure this in your Vercel project settings (Environment Variables).
# NEVER use the VITE_ prefix for secret keys — Vite inlines those into the public bundle.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: comma-separated list of origins allowed to call /api/coach.
# Defaults to https://keywarp.vercel.app — add your custom domain(s) here.
ALLOWED_ORIGINS=https://keywarp.vercel.app
